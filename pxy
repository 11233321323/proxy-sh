# Get current language
get_language() {
    if [ -f "$LANG_FILE" ]; then
        cat "$LANG_FILE"
    else
        echo "EN"
    fi
}

# Get translation string
translate() {
    local key=$1
    local lang=$(get_language)
    local var_name="LANG_${lang}[$key]"
    echo "${!var_name:-$key}"
}

init_config() {
    if [ ! -d "$CONFIG_DIR" ]; then
        mkdir -p "$CONFIG_DIR"
    fi
    if [ ! -f "$CONFIG_FILE" ]; then
        echo '{"proxies":[]}' > "$CONFIG_FILE"
    fi
    if [ ! -f "$LANG_FILE" ]; then
        echo "EN" > "$LANG_FILE"
        show_language_setup
    fi
}

show_language_setup() {
    echo ""
    echo "Welcome to proxy-sh! / 欢迎使用 proxy-sh! / proxy-sh へようこそ！/ proxy-sh에 오신 것을 환영합니다!"
    echo ""
    echo "1) English"
    echo "2) 中文 (Chinese)"
    echo "3) 日本語 (Japanese)"
    echo "4) 한국어 (Korean)"
    echo ""
    read -p "Select language / 选择语言 / 言語を選択 / 언어를 선택하세요: " lang_choice

    case $lang_choice in
        1) echo "EN" > "$LANG_FILE"; CURRENT_LANG="EN" ;;
        2) echo "CN" > "$LANG_FILE"; CURRENT_LANG="CN" ;;
        3) echo "JP" > "$LANG_FILE"; CURRENT_LANG="JP" ;;
        4) echo "KO" > "$LANG_FILE"; CURRENT_LANG="KO" ;;
        *) echo "EN" > "$LANG_FILE"; CURRENT_LANG="EN" ;;
    esac
    echo ""
}

list_proxies() {
    jq -r '.proxies[] | "\(.name) (\(.protocol)://\(.host):\(.port))"' "$CONFIG_FILE" 2>/dev/null || echo "$(translate no_proxies)"
}

add_proxy() {
    read -p "$(translate proxy_name) " name
    read -p "$(translate proxy_protocol) " protocol
    read -p "$(translate proxy_host) " host
    read -p "$(translate proxy_port) " port

    local proxy_url="${protocol}://${host}:${port}"
    jq ".proxies += [{\"name\":\"$name\",\"protocol\":\"$protocol\",\"host\":\"$host\",\"port\":$port}]" "$CONFIG_FILE" > "$CONFIG_FILE.tmp" && mv "$CONFIG_FILE.tmp" "$CONFIG_FILE"
    echo "$(translate added_proxy) $name"
}

enable_proxy() {
    local proxies=($(jq -r '.proxies[].name' "$CONFIG_FILE" 2>/dev/null))

    if [ ${#proxies[@]} -eq 0 ]; then
        echo "$(translate no_proxies)"
        return
    fi

    PS3="$(translate select_proxy) "
    select proxy_name in "${proxies[@]}" "$(translate exit_menu)"; do
        if [ "$proxy_name" = "$(translate exit_menu)" ] || [ -z "$proxy_name" ]; then
            break
        fi

        local proxy_data=$(jq ".proxies[] | select(.name==\"$proxy_name\")" "$CONFIG_FILE")
        local protocol=$(echo "$proxy_data" | jq -r '.protocol')
        local host=$(echo "$proxy_data" | jq -r '.host')
        local port=$(echo "$proxy_data" | jq -r '.port')

        local proxy_url="${protocol}://${host}:${port}"

        export http_proxy="$proxy_url"
        export https_proxy="$proxy_url"
        export HTTP_PROXY="$proxy_url"
        export HTTPS_PROXY="$proxy_url"
        export ALL_PROXY="$proxy_url"
        export all_proxy="$proxy_url"

        echo "$(translate proxy_enabled) $proxy_name"
        echo "  $(translate url) $proxy_url"
        echo "  $(translate session) $$"

        break
    done
}

disable_proxy() {
    unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY all_proxy
    echo "$(translate proxy_disabled)"
}

show_status() {
    if [ -n "$http_proxy" ]; then
        echo "$(translate proxy_status_on) $http_proxy"
    else
        echo "$(translate proxy_status_off)"
    fi
}

change_language() {
    echo ""
    echo "1) English"
    echo "2) 中文 (Chinese)"
    echo "3) 日本語 (Japanese)"
    echo "4) 한국어 (Korean)"
    echo ""
    read -p "$(translate select_language) " lang_choice

    case $lang_choice in
        1) echo "EN" > "$LANG_FILE"; echo "$(translate language_changed) English" ;;
        2) echo "CN" > "$LANG_FILE"; echo "$(translate language_changed) 中文" ;;
        3) echo "JP" > "$LANG_FILE"; echo "$(translate language_changed) 日本語" ;;
        4) echo "KO" > "$LANG_FILE"; echo "$(translate language_changed) 한국어" ;;
        *) echo "$(translate invalid_option)" ;;
    esac
}

main() {
    init_config

    while true; do
        echo ""
        echo "$(translate menu_title)"
        echo "1) $(translate enable_proxy)"
        echo "2) $(translate add_proxy)"
        echo "3) $(translate list_proxies)"
        echo "4) $(translate disable_proxy)"
        echo "5) $(translate status)"
        echo "6) $(translate change_lang)"
        echo "7) $(translate exit_menu)"
        echo ""

        read -p "$(translate choose_option) " choice

        case $choice in
            1) enable_proxy ;;
            2) add_proxy ;;
            3) list_proxies ;;
            4) disable_proxy ;;
            5) show_status ;;
            6) change_language ;;
            7) break ;;
            *) echo "$(translate invalid_option)" ;;
        esac
    done
}

main "$@"
